# ── Node.js dependencies ──────────────────────────────────────────────────────
# Installed locally by `npm install`; not committed because they are large,
# platform-specific, and fully reproducible from package.json + package-lock.json.
node_modules/

# ── Electron build output ─────────────────────────────────────────────────────
# Generated by `npm run build`. Contains the compiled .exe installer and
# unpacked app directory. Rebuilt from source on demand.
dist-app/

# ── Android build output ──────────────────────────────────────────────────────
# Generated by Gradle / Android Studio. All of these are reproducible:
#   android/app/build/  — compiled APK, .dex files, intermediate objects
#   android/build/      — top-level Gradle build cache
#   android/.gradle/    — Gradle wrapper cache and daemon state
#   android/.cxx/       — CMake/NDK intermediate files (if native C++ is added)
android/app/build/
android/build/
android/.gradle/
android/.cxx/

# local.properties contains the absolute path to the Android SDK on the
# developer's machine (sdk.dir=...). It is machine-specific and must not
# be shared — each developer generates it automatically when opening the
# project in Android Studio.
android/local.properties

# Web assets copied into the Android project by `npx cap sync android`.
# The source of truth is mobile/; this directory is always regenerated before building.
android/app/src/main/assets/public/

# Capacitor copies its config JSON into the Android assets folder during sync.
# The source of truth is capacitor.config.json at the repo root.
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# ── PC server runtime files ───────────────────────────────────────────────────
# Created at runtime; contain user data or machine-specific state.
# When running in Electron, MAGSENSOR_DATA_DIR redirects these to the OS
# user-data folder (%APPDATA%\MagSensor) so they never land here.
# When running standalone (node pc/server.js), they land in pc/.
pc/recordings/
pc/config.json

# ── OS and editor metadata ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
.vscode/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local

# ── Claude Code ───────────────────────────────────────────────────────────────
# Project-level Claude Code state: conversation memory, session cache, and
# other files written by the claude CLI tool. Not part of the source code.
.claude/
